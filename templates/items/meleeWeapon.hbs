
<form autocomplete='off' class='weapon-form dialog'>
    <div class='weapon-header'>
        <img class='weapon-image' src='{{item.img}}' title='{{item.name}}' data-edit='img' />
        <input name='name' type='text' value='{{item.name}}' class='weapon-name-input' placeholder='Weapon Name' />
    </div>

    <div class='flex-row'>
        <hr class='dialog-section-before' /><div class='dialog-section-text'>{{localize 'BW.stargaze.weapon.section.basics'}} </div><hr class='dialog-section-after' />
        <div class='section-content'>
            <div class='dialog-row'>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.quality'}}</span>
                    <input type='number' name='system.weaponQuality' value='{{system.weaponQuality}}' class='short-input' />
                </div>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.msrp'}}</span>
                        <input type='text' name='system.MSRP' value='{{system.MSRP}}' class='medium-input' />
                    </div>
                </div>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.handedness'}}</span>
                    <select name='system.handedness' class='short-input'>
                        <option value='one' {{#if (eq system.handedness 'one')}}selected{{/if}}>{{localize 'BW.stargaze.weapon.oneHanded'}}</option>
                        <option value='two' {{#if (eq system.handedness 'two')}}selected{{/if}}>{{localize 'BW.stargaze.weapon.twoHanded'}}</option>
                    </select>
                </div>
            </div>
            <div class='dialog-row'>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.integrity'}}</span>
                    <div class='input-group'>
                        <input type='number' name='system.integrity' value='{{system.integrity}}' class='short-input' />
                        <span>/</span>
                        <input type='number' name='system.integrityMax' value='{{system.integrityMax}}' class='short-input' />
                    </div>
                </div>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.skillRepair'}}</span>
                        <input class='medium-input' type='text' name='system.skillRepair' value='{{system.skillRepair}}' placeholder='{{localize 'BW.stargaze.weapon.repairSkillPlaceholder'}}' />
                        <input type='hidden' name='system.skillRepairId' value='{{system.skillRepairId}}' />
                    </div>
                </div>
            </div>
            <div class='dialog-row'>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.skill'}}</span>
                        <input class='medium-input' type='text' name='system.skill' value='{{system.skill}}' placeholder='{{localize 'BW.stargaze.weapon.skillPlaceholder'}}' />
                        <input type='hidden' name='system.skillId' value='{{system.skillId}}' />
                    </div>
                </div>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.manufacturer'}}</span>
                        <input class='medium-input' type='text' name='system.manufacturer' value='{{system.manufacturer}}' placeholder='{{localize 'BW.stargaze.weapon.manufacturerPlaceholder'}}' />
                    </div>
                </div>
            </div>
            <div class="section-spacer"></div>
        </div>
    </div>

    <div class='flex-row'>
        <hr class='dialog-section-before' /><div class='dialog-section-text'>{{localize 'BW.stargaze.weapon.section.combat'}} </div><hr class='dialog-section-after' />
        <div class='section-content'>
            <div class='dialog-row'>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.range'}}</span>
                    <input type='number' name='system.range' value='{{system.range}}' class='short-input' title='{{localize 'BW.stargaze.weapon.range'}}' />
                </div>
                <div class='form-group ap-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.ap'}}</span>
                    <div class='input-group'>
                        <input type='number' name='system.APPerShot' value='{{system.APPerShot}}' class='short-input' title='{{localize 'BW.stargaze.weapon.apPerShot'}}' />
                        {{#if system.usesAmmunition}}<span>/</span>
                        <input type='number' name='system.APPerReload' value='{{system.APPerReload}}' class='short-input' title='{{localize 'BW.stargaze.weapon.apPerReload'}}' />{{/if}}
                    </div>
                </div>
            </div>
            <div class='dialog-row'>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.skillMitigation'}}</span>
                        <input class='medium-input' type='text' name='system.skillMitigation' value='{{system.skillMitigation}}' placeholder='{{localize 'BW.stargaze.weapon.mitigationSkillPlaceholder'}}' />
                        <input type='hidden' name='system.skillMitigationId' value='{{system.skillMitigationId}}' />
                    </div>
                </div>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.skillAvoidance'}}</span>
                        <input class='medium-input' type='text' name='system.skillAvoidance' value='{{system.skillAvoidance}}' placeholder='{{localize 'BW.stargaze.weapon.avoidanceSkillPlaceholder'}}' />
                        <input type='hidden' name='system.skillAvoidanceId' value='{{system.skillAvoidanceId}}' />
                    </div>
                </div>
            </div>
            <div class="section-spacer"></div>
        </div>
    </div>

    <div class='flex-row'>
        <hr class='dialog-section-before' /><div class='dialog-section-text'>{{localize 'BW.stargaze.weapon.section.ammo'}} </div><hr class='dialog-section-after' />
        <div class='section-content'>
            <div class='dialog-row'>
                <div class='form-group uses-ammo-group'>
                    <input type='checkbox' name='system.usesAmmunition' id='usesAmmunition' {{#if system.usesAmmunition}}checked{{/if}} />
                    <label for='usesAmmunition' class='uses-ammo-label'>{{localize 'BW.stargaze.weapon.usesAmmunition'}}</label>
                </div>
            </div>
            {{#if system.usesAmmunition}}
            <div class='dialog-row'>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.shots'}}</span>
                    <div class='input-group'>
                        <input type='number' name='system.chargeLevel' value='{{system.chargeLevel}}' class='short-input' />
                        <span>/</span>
                        <input type='number' name='system.chargeLevelMax' value='{{system.chargeLevelMax}}' class='short-input' />
                    </div>
                </div>
                <div class='form-group'>
                    <div class='input-group'>
                        <span class='label'>{{localize 'BW.stargaze.weapon.ammoType'}}</span>
                        <input type='text' name='system.ammoType' value='{{system.ammoType}}' class='short-input' />
                    </div>
                </div>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.reloadType'}}</span>
                    <select name='system.reloadType' class='medium-input'>
                        <option value='per shot' {{#if (eq system.reloadType 'per shot')}}selected{{/if}}>{{localize 'BW.stargaze.weapon.perShot'}}</option>
                        <option value='magazine' {{#if (eq system.reloadType 'magazine')}}selected{{/if}}>{{localize 'BW.stargaze.weapon.magazine'}}</option>
                        <option value='battery' {{#if (eq system.reloadType 'battery')}}selected{{/if}}>{{localize 'BW.stargaze.weapon.battery'}}</option>
                    </select>
                </div>
            </div>
            <div class='dialog-row'>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.ammoPerReload'}}</span>
                    <input type='number' name='system.AmmoPerReload' value='{{system.AmmoPerReload}}' class='short-input' />
                </div>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.chargePerAmmo'}}</span>
                    <input type='number' name='system.chargePerAmmo' value='{{system.chargePerAmmo}}' class='short-input' />
                </div>
                <div class='form-group'>
                    <span class='label'>{{localize 'BW.stargaze.weapon.shotsPerCharge'}}</span>
                    <input type='number' name='system.shotsPerCharge' value='{{system.shotsPerCharge}}' class='short-input' />
                </div>
            </div>
            {{/if}}
            <div class="section-spacer"></div>
        </div>
    </div>

    <div class='flex-row'>
        <hr class='dialog-section-before' /><div class='dialog-section-text'>{{localize 'BW.stargaze.weapon.section.desc'}} </div><hr class='dialog-section-after' />
        <div class='section-content'>
            <textarea name='system.description' placeholder='{{localize 'BW.stargaze.weapon.descriptionPlaceholder'}}'>{{system.description}}</textarea>
        </div>
    </div>
</form>
