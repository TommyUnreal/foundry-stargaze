<div class='item-grid armor-grid' aria-label="armor section">
    <div class='armor-header'>🛡️</div>
    <div class='armor-header'>{{localize 'BW.dice'}}</div>
    <div class='armor-header'>{{localize 'BW.armor.damage'}}</div>
    <div class='armor-header'>{{localize 'BW.armor.location'}}</div>
    <div class='armor-header'>{{localize 'BW.armor.skill'}}</div>
    <div class='armor-header'>{{localize 'BW.name'}}</div>

    {{#if armor.helm}}
        <button
            aria-label="roll helm"
            type='button'
            class='rollable {{armor.helm.system.helmDisplayClass}}'
            data-roll-type='armor'
            data-item-id='{{armor.helm._id}}'
            data-location='Helm'
        >
            <i class='fas fa-dice'></i>
        </button>
        <div
            class='armor-row'
        >{{armor.helm.system.shade}}{{armor.helm.system.dice}}</div>
        <input
            type='number'
            class='armor-damage-input {{armor.helm.system.helmDisplayClass}}'
            data-item-id='{{armor.helm._id}}'
            data-binding='system.damageHelm'
            value='{{armor.helm.system.damageHelm}}'
        />
    {{else}}
        <button disabled><i class='fas fa-dice'></i></button>
        <div class='armor-row'></div>
        <div class='armor-row'></div>
    {{/if}}
    <div class='armor-row'>{{localize 'BW.armor.helm'}}</div>
    <div class='armor-row'>{{armor.helm.system.skill}}</div>
    <div class='armor-row'>{{armor.helm.name}}</div>

