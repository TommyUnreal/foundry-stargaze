<div class="item-grid ranged-grid">
    <div class="weapon-header">{{localize "BW.stargaze.weapon.categoryMelee"}}</div>
    <div class="weapon-header">{{localize "BW.stargaze.weapon.quality"}}</div>
    <div class="weapon-header">{{localize "BW.stargaze.weapon.range"}}</div>
    <div class="weapon-header">{{localize "BW.stargaze.weapon.integrity"}}</div>
    <div class="weapon-header">{{localize "BW.stargaze.weapon.loaded"}}</div>
    <div class="weapon-header">{{localize "BW.stargaze.weapon.skill"}}</div>
    <div class="weapon-header">🗡️</div>
    {{#each melee as |m|}}
        <div class="weapon-group" aria-label="melee weapon {{m.name}}">
            <div class="weapon-row weapon-name" data-roll-type="weapon" data-weapon-id="{{m._id}}" {{#if ../isOwner}}draggable="true"{{/if}}>
                <div class="ims-pair">
                    <div class="weapon-ims">{{m.name}}</div>
                    <label class="weapon-dof">[{{m.system.manufacturer}}]</label>
                </div>
            </div>
            <div class="weapon-row">
                <div class="ims-pair">
                    <div class="weapon-ims">
                        {{#if (gte m.system.weaponQuality 0)}}+{{/if}}{{m.system.weaponQuality}}
                    </div>
                    <label class="weapon-dof">MOD</label>
                </div>
            </div>
            <div class="weapon-row">
                <div class="ims-pair">
                    <div class="weapon-ims">{{m.system.range}}</div>
                    <label class="weapon-dof">{{#if (gt m.system.range 1)}}REACH{{else}}SHORT{{/if}}</label>
                </div>
            </div>
            <div class="weapon-row">
                <div class="ims-pair">
                    <div class="weapon-ims">{{m.system.integrity}}/{{m.system.integrityMax}}</div>
                    <label class="weapon-dof">{{#if (eq m.system.integrity m.system.integrityMax)}}INTACT{{else if (gt m.system.integrity 0)}}DAMAGED{{else}}BROKEN{{/if}}</label>
                </div>
            </div>
            <div class="weapon-row">
                <div class="ims-pair">
                    <div class="weapon-ims">
                        {{#if m.system.usesAmmunition}}
                            {{m.system.chargeLevel}}/{{m.system.chargeLevelMax}}
                        {{else}}-
                        {{/if}}
                    </div>
                    <label class="weapon-dof">{{#if m.system.usesAmmunition}}[{{m.system.ammoType}}]{{/if}}</label>
                </div>
            </div>
            <div class="weapon-row">
                <select class="weapon-skill-select" data-item-id="{{m._id}}" data-binding="system.skillId" value="{{m.system.skillId}}">
                    {{selectOptions ../skills localize=true selected=m.system.skillId valueAttr="id" labelAttr="label"}}
                </select>
            </div>
            <div class="weapon-row">
                <button
                    aria-label="roll attack"
                    type="button"
                    class="rollable modifiable"
                    data-roll-type="weapon"
                    data-skill-id="{{m.system.skillId}}"
                    data-weapon-id="{{m._id}}"
                    {{#if ../isOwner}}draggable="true"{{/if}}
                    >
                    <i class="fas fa-dice"></i>
                </button>
            </div>
        </div>
    {{/each}}
</div>
<hr>
