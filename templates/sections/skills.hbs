<h2 class="section-header">
    {{#if isOwner}}
    <input type="checkbox" id="{{actor.id}}-collapseSkills" name="system.collapseSkills" class="section-collapse" {{ checked system.collapseSkills }}>
    <i class="fas fa-chevron-down"></i>
    {{/if}}
    <label for="{{actor.id}}-collapseSkills" class="section-collapse-label clickable">{{ localize "BW.skill.skills" }}</label>
</h2>
{{#if system.collapseSkills}}{{else}}

    <!-- TODO: Needs to be generalized -->

    <!-- Martial Skills -->
    <div class="skill-category">
        <h3 class="skill-category-header">{{localize "BW.stargaze.skills.martial"}}</h3>
        <div class="skills" aria-label="skills section">
        {{#each skills as |skill|}}
            {{#if (eq skill.system.skilltype "martial")}}
                {{> "systems/burningwheel/templates/parts/rollable-skill.hbs" skill=skill isOwner=isOwner}}
            {{/if}}
        {{/each}}
        </div>
    </div>

