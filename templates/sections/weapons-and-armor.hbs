<h2 class="section-header">
    {{#if isOwner}}
    <input type="checkbox" id="{{actor.id}}-collapseCombat" name="system.collapseCombat" class="section-collapse" {{ checked system.collapseCombat }}>
    <i class="fas fa-chevron-down"></i>
    {{/if}}
    <label for="{{actor.id}}-collapseCombat" class="section-collapse-label clickable">{{localize "BW.character.weaponsAndArmor"}}</label>
</h2>
{{#if system.collapseCombat}}{{else}}
<div class="combat-section flex-row">
    <div class="weapons">
        {{> "systems/burningwheel/templates/parts/weapons.hbs" melee=melee ranged=ranged skills=martialSkillOptions}}
    </div>
    <div class="armor-misc flex-column">
        <div class="training-skills">
            <hr>
            <h3>{{localize "BW.stargaze.character.ammoSection"}}</h3>
                {{#each equipment as |e|}}
                <div class="{{e.system.cssClass}}" {{#if ../isOwner}}draggable="true"{{/if}} data-id="{{e._id}}">

                    {{#if (eq e.system.tag "ammo")}}
                    <div class="ammo-row">
                        <div class="ammo-name">{{e.name}}</div>
                        <div class="ammo-amount">
                            <input
                                type="number"
                                class="ammo-amount-input"
                                min="0"
                                data-item-id="{{e._id}}"
                                data-binding="system.amount"
                                value="{{e.system.amount}}"
                            />
                            <span class="ammo-amount-symbol">✖</span>
                        </div>
                        {{#if ../isOwner}}
                            <div class="ammo-actions">
                                <i class="fas fa-trash item-action-icon" data-action="delItem" data-id="{{e._id}}"></i>
                                <i class="fas fa-edit item-action-icon" data-action="editItem" data-id="{{e._id}}"></i>
                            </div>
                        {{/if}}
                    </div>
                    {{/if}}

                </div>
                {{/each}}
                <br />
                {{#if isOwner}}
                <div class="right-floating">
                    <div class="add-button" data-action="addAmmo"><i class="fas fa-plus"></i> {{localize "BW.character.addNew" type=(localize "BW.stargaze.character.ammo")}}</div>
                </div>
                {{/if}}
        </div>
    </div>
    <div class="armor">
        <hr>
        {{> "systems/burningwheel/templates/parts/armor.hbs" armor=armor }}
    </div>
</div>
{{/if}}
